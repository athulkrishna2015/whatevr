#!/usr/bin/env python3
"""Record a running daemon's view stream to NDJSON, for replay and soak.

Subscribes to every view the daemon serves, writes one frame per line, and
stops on a deadline or on Ctrl-C. The result is what `protocol-fixture
--script` replays and what `scripts/conformance --replay` asserts against, so
a stream that broke something once can be made to break it again.

The recording is real conversation data. It stays on the machine it was taken
on unless you have read it and decided otherwise.
"""

from __future__ import annotations

import argparse
import json
import os
import signal
import socket
import sys
import time
from pathlib import Path


# Every view a frontend opens, and the parameters it opens them with. The
# per-chat views are filled in from the chats the recording sees.
GLOBAL_VIEWS: list[tuple[str, dict[str, object]]] = [
    ("connection", {}),
    ("sync", {}),
    ("self", {}),
    ("chats", {"limit": 50}),
    ("typing", {}),
    ("privacy", {}),
    ("preferences", {}),
    ("blocklist", {}),
    ("transfers", {}),
    ("stickers", {"limit": 50}),
    ("sticker_packs", {"limit": 50}),
]

PER_CHAT_VIEWS: list[tuple[str, dict[str, object]]] = [
    ("messages", {"limit": 50, "anchor": "latest"}),
    ("chat", {}),
    ("pinned", {"limit": 20}),
    ("live_locations", {}),
    ("chat_media", {"limit": 30}),
]


class Recorder:
    def __init__(self, socket_path: Path, out: str) -> None:
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(10)
        self.sock.connect(str(socket_path))
        self.buf = b""
        self.next_id = 1
        # sub id -> (view name, chat id), so a frame can name the window it
        # came from rather than an id that means nothing after the socket dies.
        self.windows: dict[int, tuple[str, str]] = {}
        self.out = open(out, "w", encoding="utf-8")
        self.frames = 0

    def close(self) -> None:
        self.out.close()
        self.sock.close()

    def send(self, obj: dict[str, object]) -> object:
        req_id = self.next_id
        self.next_id += 1
        obj = dict(obj, id=req_id)
        self.sock.sendall(json.dumps(obj, separators=(",", ":")).encode() + b"\n")
        return req_id

    def read(self, timeout: float) -> dict[str, object] | None:
        self.sock.settimeout(timeout)
        while b"\n" not in self.buf:
            try:
                chunk = self.sock.recv(65536)
            except (TimeoutError, socket.timeout):
                return None
            if not chunk:
                return None
            self.buf += chunk
        line, self.buf = self.buf.split(b"\n", 1)
        try:
            return json.loads(line)
        except json.JSONDecodeError:
            return None

    def write_frame(self, sub: int, msg: dict[str, object]) -> None:
        view, chat_id = self.windows.get(sub, ("unknown", ""))
        frame: dict[str, object] = {"view": view, "event": msg.get("event")}
        if chat_id:
            frame["chat_id"] = chat_id
        for key in ("sort", "item", "id", "exhausted"):
            if key in msg:
                frame[key] = msg[key]
        self.out.write(json.dumps(frame, separators=(",", ":")) + "\n")
        self.frames += 1


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--socket", default=os.environ.get("WHATEVR_CONFORMANCE_SOCKET", ""),
                        help="daemon socket (default: $WHATEVR_CONFORMANCE_SOCKET, else the usual path)")
    parser.add_argument("--out", required=True, help="NDJSON file to write")
    parser.add_argument("--seconds", type=float, default=10.0,
                        help="how long to keep recording after the initial fills")
    parser.add_argument("--chats", type=int, default=3,
                        help="how many of the newest chats to open transcripts for")
    args = parser.parse_args()

    socket_path = args.socket
    if not socket_path:
        runtime = os.environ.get("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid())
        socket_path = runtime + "/whatevr/whatevrd.sock"
    if not Path(socket_path).exists():
        print("record-stream: no daemon socket at %s" % socket_path, file=sys.stderr)
        return 1

    rec = Recorder(Path(socket_path), args.out)
    stopping = False

    def stop(*_: object) -> None:
        nonlocal stopping
        stopping = True

    signal.signal(signal.SIGINT, stop)
    signal.signal(signal.SIGTERM, stop)

    try:
        hello_id = rec.send({"method": "hello", "params": {"client": "record-stream", "protocol": 1}})
        while True:
            msg = rec.read(10)
            if msg is None:
                print("record-stream: no hello answer", file=sys.stderr)
                return 1
            if msg.get("id") == hello_id:
                if "error" in msg:
                    print("record-stream: hello rejected: %r" % (msg["error"],), file=sys.stderr)
                    return 1
                break

        pending: dict[object, tuple[str, str]] = {}
        for view, params in GLOBAL_VIEWS:
            req = rec.send({"method": "subscribe", "params": dict(params, view=view)})
            pending[req] = (view, "")

        deadline = time.time() + args.seconds
        chats_opened = 0
        # One pass over everything that arrives: subscribe answers register a
        # window, view events are written out, and the first few chats seen get
        # their per-chat views opened as they arrive.
        while not stopping and time.time() < deadline:
            msg = rec.read(0.5)
            if msg is None:
                continue
            if "id" in msg:
                window = pending.pop(msg["id"], None)
                result = msg.get("result")
                if window and isinstance(result, dict) and isinstance(result.get("sub"), int):
                    rec.windows[result["sub"]] = window
                continue
            sub = msg.get("sub")
            if not isinstance(sub, int):
                continue
            rec.write_frame(sub, msg)

            view, _ = rec.windows.get(sub, ("", ""))
            item = msg.get("item")
            if (view == "chats" and msg.get("event") == "upsert" and isinstance(item, dict)
                    and chats_opened < args.chats):
                chat_id = str(item.get("id", ""))
                if chat_id:
                    chats_opened += 1
                    for per_view, params in PER_CHAT_VIEWS:
                        req = rec.send({"method": "subscribe",
                                        "params": dict(params, view=per_view, chat_id=chat_id)})
                        pending[req] = (per_view, chat_id)

        print("record-stream: wrote %d frames from %d window(s) to %s"
              % (rec.frames, len(rec.windows), args.out))
        return 0
    finally:
        rec.close()


if __name__ == "__main__":
    raise SystemExit(main())
