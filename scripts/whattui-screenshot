#!/usr/bin/env python3
"""Photograph real whattui frames in an isolated kitty window.

A camera, not a test. For looking at, by a person or an agent, when something
about a frame needs eyes on it. Nothing here compares anything: it builds
whattui and a mock-mode whatevrd, runs a real daemon against a fake WhatsApp
server on a private socket, opens a kitty of exactly the size asked for on a
Hyprland headless output nobody is looking at, drives it with whatever keys were
asked for, and writes a png once the frame has stopped changing. The real
account and the real screen are never involved.

The clock is the real one and the account is live, so a picture looks like an
account rather than like a fixture. Frame comparison lives in whattui's golden
tests, which pin both.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import shlex
import shutil
import signal
import subprocess
import sys
import time
import uuid
from pathlib import Path
from typing import Any

from PIL import Image

ROOT = Path(__file__).resolve().parents[1]
OUTPUT = ROOT / "build" / "whattui-screenshots"
# The accounts that can be photographed: a mock scenario name, the chat whose
# name proves the list has drawn, and the text that proves the transcript has.
# Another account is fine, this is a camera and what you point it at is your
# business, but it is always a scenario and never a real account.
ACCOUNTS = {
    "visual": ("Visual Test Group", "READY-HARNESS"),
    "frames": ("Reference", "READY-HARNESS"),
    "busy": ("Team standup", "standing up"),
    "media": ("Media test group", "and that is everything else"),
    "torture": ("Text torture", "--- zalgo ---"),
    "flood": ("Group 00", "group 00 message"),
    "fuzz": ("", ""),
    "sync": ("Syncing group", "group history"),
    "echo": ("Echo chamber", "same in here"),
    "empty": ("", ""),
}
DEFAULT_ACCOUNT = "visual"
# The account actually served.
account = DEFAULT_ACCOUNT
# Environment whattui is started with, from --env.
EXTRA_ENV: dict[str, str] = {}
KITTY_CONFIG = ROOT / "scripts" / "whattui-kitty.conf"
DEFAULT_SIZE = (120, 40)
# The states worth a picture, each opened the way a user opens it and each
# proved on screen before it is photographed. Any of them can be taken at any
# size; the size here is only the default.
#
# name -> (cols, rows, keys, marker on screen once the keys have landed)
SCENARIOS = {
    "chat": (120, 40, [], ""),
    "palette": (120, 40, ["ctrl+p"], "Command palette"),
    "palette-chats": (120, 40, ["ctrl+p", "/", "a", "n"], "> /an"),
    "slash": (120, 40, ["/"], "Slash commands"),
    "help": (120, 40, ["tab", "?"], "Keyboard help"),
    "leader": (120, 40, ["ctrl+x"], "^x"),
    "transcript": (120, 40, ["tab"], "scroll"),
}
TIMEOUT = 30.0
OUTPUT_MODE = "1920x1200@60"
OUTPUT_POSITION = "8192x0"
OUTPUT_SCALE = "1"


class Failure(RuntimeError):
    pass


class SignalExit(RuntimeError):
    def __init__(self, signum: int) -> None:
        super().__init__(f"interrupted by {signal.Signals(signum).name}")
        self.signum = signum


def run(
    cmd: list[str],
    *,
    cwd: Path = ROOT,
    check: bool = True,
    capture: bool = True,
    env: dict[str, str] | None = None,
) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(
        cmd,
        cwd=cwd,
        text=True,
        env=env,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.PIPE if capture else None,
        check=False,
    )
    if check and result.returncode:
        detail = ((result.stdout or "") + (result.stderr or "")).strip()
        raise Failure(
            f"command failed ({result.returncode}): {' '.join(cmd)}\n{detail}"
        )
    return result


def version(cmd: list[str]) -> str:
    result = run(cmd, check=False)
    text = ((result.stdout or "") + (result.stderr or "")).strip()
    return text.splitlines()[0] if text else f"unavailable ({result.returncode})"


def wait_for(description: str, predicate: Any, timeout: float = TIMEOUT) -> Any:
    deadline = time.monotonic() + timeout
    last_error: Exception | None = None
    while time.monotonic() < deadline:
        try:
            value = predicate()
            if value:
                return value
        except (OSError, ValueError, subprocess.SubprocessError, Failure) as exc:
            last_error = exc
        time.sleep(0.05)
    suffix = f": {last_error}" if last_error else ""
    raise Failure(f"timed out waiting for {description}{suffix}")


def tools_metadata() -> dict[str, str]:
    font = version(["fc-match", "-f", "%{family}|%{style}|%{file}", "Noto Sans Mono"])
    font_file = font.rsplit("|", 1)[-1] if "|" in font else ""
    font_version = (
        version(["fc-query", "-f", "%{fontversion}", font_file])
        if font_file
        else "unknown"
    )
    return {
        "kitty": version(["kitty", "--version"]),
        "grim": version(["grim", "-h"]),
        "hyprland": version(["hyprctl", "version"]),
        "python": sys.version.splitlines()[0],
        "pillow": Image.__version__,
        "font": font,
        "font_version": font_version,
    }


def required_tools() -> None:
    missing = [
        name
        for name in ("go", "kitty", "grim", "hyprctl", "fc-match", "fc-query")
        if shutil.which(name) is None
    ]
    if missing:
        raise Failure("missing tools: " + ", ".join(missing))


def hypr_json(command: str) -> Any:
    return json.loads(run(["hyprctl", command, "-j"]).stdout)


def active_workspace_identity() -> tuple[int, str, str]:
    workspace = hypr_json("activeworkspace")
    return int(workspace["id"]), str(workspace["name"]), str(workspace["monitor"])


class HeadlessOutput:
    def __init__(self) -> None:
        self.name: str | None = None
        self.monitor_id: int | None = None
        # The output's own workspace, read back once it exists. A workspace of
        # our own would have to be made active on the monitor to be composited,
        # and a window on an inactive workspace is a window kitty reports as
        # not visible, which is a frontend that stops rendering.
        self.workspace: str | None = None
        self.initial_workspace = active_workspace_identity()
        self.workspace_observations: list[dict[str, Any]] = []

    def create(self) -> str:
        before = {str(monitor["name"]) for monitor in hypr_json("monitors")}
        result = run(["hyprctl", "output", "create", "headless"])

        def new_monitor() -> str | None:
            names = {str(monitor["name"]) for monitor in hypr_json("monitors")}
            added = names - before
            if len(added) == 1:
                return added.pop()
            if len(added) > 1:
                mentioned = [name for name in added if name in result.stdout]
                if len(mentioned) == 1:
                    return mentioned[0]
                raise Failure(
                    f"headless output creation added multiple monitors: {sorted(added)}"
                )
            return None

        self.name = wait_for("new Hyprland headless output", new_monitor)
        monitor_rule = (
            "hl.monitor({ "
            f"output = {json.dumps(self.name)}, "
            f"mode = {json.dumps(OUTPUT_MODE)}, "
            f"position = {json.dumps(OUTPUT_POSITION)}, "
            f"scale = {OUTPUT_SCALE} "
            "})"
        )
        configured_result = run(["hyprctl", "eval", monitor_rule])
        if configured_result.stdout.strip() != "ok":
            raise Failure(
                f"Hyprland rejected headless monitor rule: {configured_result.stdout.strip()}"
            )

        def configured() -> dict[str, Any] | None:
            for monitor in hypr_json("monitors"):
                if monitor.get("name") == self.name:
                    geometry = (
                        monitor.get("width"),
                        monitor.get("height"),
                        monitor.get("x"),
                        monitor.get("y"),
                        monitor.get("scale"),
                    )
                    if geometry == (1920, 1200, 8192, 0, 1):
                        return monitor
            return None

        monitor = wait_for("configured Hyprland headless output", configured)
        self.monitor_id = int(monitor["id"])
        self.workspace = str(monitor["activeWorkspace"]["name"])
        self.observe_active_workspace("output-configured")
        return self.name

    def observe_active_workspace(self, stage: str) -> None:
        self.workspace_observations.append(
            {"stage": stage, "workspace": list(active_workspace_identity())}
        )

    def remove(self) -> None:
        if self.name is None:
            return
        name, self.name = self.name, None
        self.monitor_id = None
        self.workspace = None
        run(["hyprctl", "output", "remove", name], check=False)

    def metadata(self) -> dict[str, Any]:
        return {
            "name": self.name,
            "id": self.monitor_id,
            "backend": "headless",
            "mode": OUTPUT_MODE,
            "position": OUTPUT_POSITION,
            "scale": int(OUTPUT_SCALE),
            "workspace": self.workspace,
            "initial_active_workspace": list(self.initial_workspace),
            "active_workspace_observations": self.workspace_observations,
        }


def validate_account() -> str:
    """The account has to be a scenario the binary actually has."""
    if account not in ACCOUNTS:
        known = ", ".join(sorted(ACCOUNTS))
        raise Failure(f"unknown account {account!r}; known ones are {known}")
    return account


def build_binaries(run_dir: Path) -> dict[str, Path]:
    bin_dir = run_dir / "bin"
    bin_dir.mkdir(parents=True, exist_ok=True)
    whattui = bin_dir / "whattui"
    daemon = bin_dir / "whatevrd"
    run(
        ["go", "build", "-buildvcs=false", "-o", str(whattui), "./cmd/whattui"],
        cwd=ROOT / "whattui",
    )
    # The mock server mutates process-global certificate state, so it exists
    # only behind this tag and never in a release binary.
    run(
        [
            "go",
            "build",
            "-buildvcs=false",
            "-tags",
            "sqlite_fts5 whatevr_mock",
            "-o",
            str(daemon),
            "./cmd/whatevrd",
        ],
        cwd=ROOT / "whatevrd",
        env={**os.environ, "CGO_ENABLED": "1"},
    )
    return {"whattui": whattui, "whatevrd": daemon}


def child_mode(args: argparse.Namespace) -> int:
    ready = Path(args.child_ready)
    log = Path(args.child_log)
    log.parent.mkdir(parents=True, exist_ok=True)
    output = log.open("ab", buffering=0)
    os.dup2(output.fileno(), 1)
    os.dup2(output.fileno(), 2)
    ready.write_text(f"pid={os.getpid()}\n", encoding="ascii")
    os.execvpe(args.child_command[0], args.child_command, os.environ)
    return 127


class Harness:
    def __init__(
        self,
        run_dir: Path,
        binaries: dict[str, Path],
        daemon_socket: Path,
        headless: HeadlessOutput,
    ) -> None:
        self.run_dir = run_dir
        self.binaries = binaries
        self.daemon_socket = daemon_socket
        self.headless = headless
        self.states: list[dict[str, Any]] = []
        self.sequence = 0

    def remote(self, socket: Path, command: list[str], *, check: bool = True) -> str:
        return run(
            ["kitty", "@", "--to", f"unix:{socket}", *command], check=check
        ).stdout

    def kitty_tree(self, socket: Path) -> list[dict[str, Any]]:
        return json.loads(self.remote(socket, ["ls"]))

    def window(
        self, socket: Path, window_id: int
    ) -> tuple[dict[str, Any], dict[str, Any]]:
        for os_window in self.kitty_tree(socket):
            for tab in os_window.get("tabs", []):
                for window in tab.get("windows", []):
                    if window.get("id") == window_id:
                        return os_window, window
        raise Failure(f"kitty window {window_id} disappeared")

    def launch(
        self,
        cols: int,
        rows: int,
        name: str,
        plain: bool = False,
        visibility: bool = False,
    ) -> dict[str, Any]:
        self.sequence += 1
        token = f"whattui-visual-{os.getpid()}-{self.sequence}-{uuid.uuid4().hex[:8]}"
        socket = self.run_dir / f"kitty-{self.sequence}.sock"
        ready = self.run_dir / f"{name}.ready"
        log = self.run_dir / "logs" / f"{name}.log"
        env = os.environ.copy()
        env.update(
            {
                "TZ": "UTC",
                "LC_ALL": "C.UTF-8",
                "WHATTUI_FONT": "Noto Sans Mono",
                "XDG_CACHE_HOME": str(self.run_dir / "cache"),
            }
        )
        if plain:
            env["WHATTUI_TIER"] = "plain"
        # Whatever the caller wants whattui to believe about the terminal it is
        # in. Degradation is a thing you photograph, not a thing you reason
        # about from a capability table.
        env.update(EXTRA_ENV)
        # Hyprland suspends a toplevel on an output nobody is looking at, and
        # a dummy monitor is exactly that, so kitty reports the window hidden
        # and a well behaved frontend stops drawing. The scenario that tests
        # visibility keeps the reports; every other one draws regardless.
        if not visibility:
            env["WHATTUI_ALWAYS_RENDER"] = "1"
        cmd = [
            "kitty",
            "--config",
            str(KITTY_CONFIG),
            "--listen-on",
            f"unix:{socket}",
            "--class",
            token,
            "--name",
            token,
            "--title",
            token,
            "--override",
            f"initial_window_width={cols}c",
            "--override",
            f"initial_window_height={rows}c",
            str(Path(__file__).resolve()),
            "--_child",
            "--child-ready",
            str(ready),
            "--child-log",
            str(log),
            "--",
            str(self.binaries["whattui"]),
            "--socket",
            str(self.daemon_socket),
        ]
        if self.headless.name is None:
            raise Failure("headless output is not available")

        passed = ["TZ", "LC_ALL", "WHATTUI_FONT", "XDG_CACHE_HOME", *EXTRA_ENV]
        if plain:
            passed.append("WHATTUI_TIER")
        if not visibility:
            passed.append("WHATTUI_ALWAYS_RENDER")
        child_env = ["env", *(f"{key}={env[key]}" for key in passed)]

        command = shlex.join([*child_env, *cmd])
        launch = (
            "hl.dsp.exec_cmd("
            f"{json.dumps(command)}, "
            "{ "
            f"workspace = {json.dumps(self.headless.workspace + ' silent')}, "
            "float = true "
            "}"
            ")"
        )

        launch_result = run(["hyprctl", "dispatch", launch])
        if "ok" not in launch_result.stdout.lower():
            raise Failure(
                f"Hyprland rejected kitty launch: {launch_result.stdout.strip()}"
            )

        wait_for(f"kitty socket {socket}", socket.exists)
        wait_for(f"whattui child ready file {ready}", ready.exists)

        def locate() -> int | None:
            tree = self.kitty_tree(socket)
            for os_window in tree:
                for tab in os_window.get("tabs", []):
                    for window in tab.get("windows", []):
                        return int(window["id"])
            return None

        window_id = wait_for("kitty remote-control window", locate)
        state = {
            "socket": socket,
            "ready": ready,
            "log": log,
            "token": token,
            "window_id": window_id,
        }
        self.states.append(state)

        client = self.hypr_client(state)
        workspace_name = self.headless.workspace
        if client.get("workspace", {}).get("name") != workspace_name:
            raise Failure(f"kitty was not created on silent workspace {workspace_name}")

        wait_for(
            "kitty placement on headless output",
            lambda: self.hypr_client(state).get("monitor")
            == self.headless.monitor_id,
        )

        if not self.hypr_client(state).get("floating", False):
            raise Failure("Hyprland did not apply the floating exec rule")
        self.headless.observe_active_workspace("kitty-placed")
        self.resize(state, cols, rows)
        # A camera waits for the picture, not for a barrier: the daemon is
        # still syncing when whattui draws its first frame, and an account with
        # nothing in it never draws more than the connection line.
        self.wait_gone(state, "connecting to whatevrd")
        if ACCOUNTS[account][0]:
            self.wait_text(state, ACCOUNTS[account][0])
        self.remote(socket, ["send-key", "--match", f"id:{window_id}", "enter"])
        self.wait_gone(state, "pick a chat")
        return state

    def pty_size(self, state: dict[str, Any]) -> tuple[int, int]:
        _, window = self.window(state["socket"], state["window_id"])
        return int(window["columns"]), int(window["lines"])

    def cell_size(self, state: dict[str, Any]) -> tuple[int, int]:
        cols, rows = self.pty_size(state)
        width, height = self.hypr_client(state)["size"]
        if cols < 1 or rows < 1:
            raise Failure(f"kitty reports a {cols}x{rows} pty")
        return width // cols, height // rows

    # Hyprland resizes the window, not kitty. kitty's own resize-os-window
    # grows a window here and silently refuses to shrink one, and shrinking is
    # the direction a reflow bug hides in.
    def resize(self, state: dict[str, Any], cols: int, rows: int) -> None:
        for _ in range(4):
            cell_w, cell_h = self.cell_size(state)
            target = (cols * cell_w, rows * cell_h)
            # The pixels are the point, not just the cells: a window Hyprland
            # sized itself is a column wider than one sized to an exact pixel
            # count, and two captures of the same frame must be one image.
            if self.pty_size(state) == (cols, rows) and tuple(
                self.hypr_client(state)["size"]
            ) == target:
                return
            run(
                [
                    "hyprctl",
                    "dispatch",
                    "hl.dsp.window.resize({ "
                    f"x = {target[0]}, y = {target[1]}, exact = true, "
                    f"window = {json.dumps('class:' + state['token'])} "
                    "})",
                ]
            )
            try:
                wait_for(
                    f"PTY size {cols}x{rows}",
                    lambda: self.pty_size(state) == (cols, rows)
                    and tuple(self.hypr_client(state)["size"]) == target,
                    timeout=4.0,
                )
                return
            except Failure:
                continue
        raise Failure(
            f"could not resize to {cols}x{rows}; actual PTY size is {self.pty_size(state)}"
        )

    def text(self, state: dict[str, Any]) -> str:
        return self.remote(
            state["socket"],
            ["get-text", "--match", f"id:{state['window_id']}", "--extent", "screen"],
        )

    def wait_text(self, state: dict[str, Any], needle: str) -> str:
        def seen() -> str | None:
            text = self.text(state)
            return text if needle in text else None

        return self.expect(f"screen text {needle!r}", seen, state)

    def expect(self, what: str, predicate: Any, state: dict[str, Any]) -> str:
        try:
            return wait_for(what, predicate)
        except Failure as exc:
            dump = self.run_dir / "logs" / f"{state['token']}-screen.txt"
            dump.parent.mkdir(parents=True, exist_ok=True)
            report = {
                "screen": self.text(state),
                "stacks": self.stacks(state),
                "kitty": self.kitty_tree(state["socket"]),
                "hyprland": self.find_hypr_client(state),
                "headless": self.headless.metadata(),
                "monitors": hypr_json("monitors"),
            }
            dump.write_text(json.dumps(report, indent=2), encoding="utf-8")
            raise Failure(f"{exc}; state dumped to {dump}") from exc

    def wait_gone(self, state: dict[str, Any], needle: str) -> str:
        def gone() -> str | None:
            text = self.text(state)
            return text if needle not in text else None

        return self.expect(f"screen without {needle!r}", gone, state)

    def hypr_client(self, state: dict[str, Any]) -> dict[str, Any]:
        def locate() -> dict[str, Any] | None:
            return self.find_hypr_client(state)

        return wait_for("Hyprland kitty toplevel", locate)

    def find_hypr_client(self, state: dict[str, Any]) -> dict[str, Any] | None:
        for client in hypr_json("clients"):
            if (
                client.get("class") == state["token"]
                or client.get("initialClass") == state["token"]
            ):
                return client
        return None

    def grim(self, state: dict[str, Any], output: Path) -> tuple[str, dict[str, Any]]:
        client = self.hypr_client(state)
        stable_id = str(client.get("stableId", ""))
        method = "foreign-toplevel"
        result = run(["grim", "-T", stable_id, "-l", "0", str(output)], check=False)
        if result.returncode:
            method = "hyprland-geometry"
            x, y = client["at"]
            width, height = client["size"]
            geometry = f"{x},{y} {width}x{height}"
            run(["grim", "-g", geometry, "-l", "0", str(output)])
        with Image.open(output) as image:
            image.load()
            pixels = [image.width, image.height]
        return method, {
            "address": client.get("address"),
            "stable_id": stable_id,
            "geometry": {"at": client.get("at"), "size": client.get("size")},
            "pixels": pixels,
        }

    # Three identical frames before the shutter: a frame caught mid-draw is a
    # picture of a bug that is not there.
    def capture(
        self, state: dict[str, Any], name: str, expected: tuple[int, int]
    ) -> Path:
        if self.pty_size(state) != expected:
            raise Failure(f"{name}: PTY is {self.pty_size(state)}, expected {expected}")
        previous: tuple[str, str] | None = None
        stable = 0
        attempts = 0
        final = self.run_dir / f"{name}.png"
        while attempts < 20:
            attempts += 1
            candidate = self.run_dir / f".{name}-{attempts}.png"
            self.grim(state, candidate)
            text = self.text(state)
            with Image.open(candidate) as image:
                image.load()
                pixel_hash = hashlib.sha256(image.convert("RGBA").tobytes()).hexdigest()
            signature = (pixel_hash, hashlib.sha256(text.encode()).hexdigest())
            stable = stable + 1 if signature == previous else 1
            previous = signature
            if stable >= 3:
                candidate.replace(final)
                break
            candidate.unlink(missing_ok=True)
            time.sleep(0.1)
        else:
            raise Failure(f"{name}: pixels and get-text did not stabilize")
        for stale in self.run_dir.glob(f".{name}-*.png"):
            stale.unlink(missing_ok=True)
        return final

    def hidden_tab_resize(self, state: dict[str, Any], cols: int, rows: int) -> None:
        hidden_id = int(
            self.remote(
                state["socket"],
                [
                    "launch",
                    "--type",
                    "tab",
                    "--match",
                    f"window_id:{state['window_id']}",
                    "--tab-title",
                    "visual-resize-cover",
                    "--title",
                    "visual-resize-cover",
                    "sh",
                    "-c",
                    "while :; do sleep 3600; done",
                ],
            ).strip()
        )
        self.remote(state["socket"], ["focus-window", "--match", f"id:{hidden_id}"])
        # kitty reports is_active per window, and a window is active in its own
        # tab whether or not anyone can see that tab. The tab is what hides.
        wait_for(
            "whattui tab to become hidden",
            lambda: not self.tab_active(state),
        )
        self.resize(state, cols, rows)
        self.remote(
            state["socket"], ["focus-window", "--match", f"id:{state['window_id']}"]
        )
        wait_for("whattui tab to become visible", lambda: self.tab_active(state))
        self.remote(state["socket"], ["close-window", "--match", f"id:{hidden_id}"])
        if ACCOUNTS[account][1]:
            self.wait_text(state, ACCOUNTS[account][1])

    # Every window of this scenario's own kitty, not just whattui's: a cover
    # tab left behind keeps the toplevel alive and the wait below never ends.
    # A surface is opened by keys, and a keystroke can be lost: kitty sends
    # them only when the program's keyboard mode says it can. One retry, from
    # a known state, is the difference between a flaky suite and a real one.
    def open_surface(
        self, state: dict[str, Any], keys: list[str], marker: str
    ) -> bool:
        for attempt in range(2):
            if attempt:
                # Back to nothing open and nothing typed before trying again.
                for reset in ("escape", "ctrl+u"):
                    self.send(state, reset)
            for key in keys:
                self.send(state, key)
            try:
                wait_for(
                    f"screen text {marker!r}",
                    lambda: marker in self.text(state),
                    timeout=6.0,
                )
                return attempt > 0
            except Failure:
                continue
        self.expect(
            f"screen text {marker!r}", lambda: marker in self.text(state) or None, state
        )
        return True

    # whattui dumps every goroutine on SIGUSR1. A frozen frame says nothing on
    # its own; this says which goroutine is waiting on what.
    def stacks(self, state: dict[str, Any]) -> str:
        ready = state.get("ready")
        if not ready or not Path(ready).exists():
            return ""
        try:
            pid = int(Path(ready).read_text(encoding="ascii").split("=")[1])
            os.kill(pid, signal.SIGUSR1)
        except (OSError, ValueError, IndexError) as exc:
            return f"(no dump: {exc})"
        dump = self.run_dir / "cache" / "whattui" / "stacks.log"
        try:
            wait_for("goroutine dump", dump.exists, timeout=5.0)
        except Failure:
            return "(no dump: whattui wrote none)"
        return dump.read_text(encoding="utf-8", errors="replace")

    # A font size change is a resize with the window standing still, which is
    # its own event and its own bug surface.
    def set_font_size(self, state: dict[str, Any], size: float) -> None:
        before = self.cell_size(state)
        self.remote(state["socket"], ["set-font-size", str(size)])
        # kitty answers with the new cell, and the pty follows it.
        wait_for(
            f"font size {size}",
            lambda: self.cell_size(state) != before,
        )

    def send(self, state: dict[str, Any], key: str) -> None:
        self.remote(state["socket"], ["send-key", "--match", f"id:{state['window_id']}", key])

    def tab_active(self, state: dict[str, Any]) -> bool:
        for os_window in self.kitty_tree(state["socket"]):
            for tab in os_window.get("tabs", []):
                for window in tab.get("windows", []):
                    if window.get("id") == state["window_id"]:
                        return bool(tab.get("is_active", False))
        raise Failure(f"kitty window {state['window_id']} is gone")

    def close(self, state: dict[str, Any]) -> None:
        self.remote(state["socket"], ["close-window", "--match", "all"], check=False)
        wait_for(
            "kitty toplevel to close", lambda: self.find_hypr_client(state) is None
        )
        if state in self.states:
            self.states.remove(state)

    # Best effort: a window that will not close must not stop the run from
    # removing the headless output it created.
    def cleanup(self) -> None:
        for state in reversed(self.states.copy()):
            try:
                self.close(state)
            except (Failure, OSError) as exc:
                print(f"whattui-screenshot: cleanup: {exc}", file=sys.stderr)
                self.states.remove(state)


def start_daemon(
    run_dir: Path, binary: Path
) -> tuple[subprocess.Popen[Any], Path, Path]:
    """Run a real whatevrd against the fake WhatsApp server, and wait for it."""
    root = run_dir / "mock"
    root.mkdir(parents=True, exist_ok=True)
    root.chmod(0o700)
    # prepareMockDir only ever clears a directory carrying this marker.
    (root / ".whatevr-mock").write_text("whattui-screenshot\n", encoding="utf-8")
    log_path = run_dir / "logs" / "whatevrd.log"
    log_path.parent.mkdir(parents=True, exist_ok=True)
    log = log_path.open("wb")
    proc = subprocess.Popen(
        [
            str(binary),
            "--mock",
            account,
            "--mock-dir",
            str(root),
        ],
        cwd=ROOT / "whatevrd",
        stdout=log,
        stderr=subprocess.STDOUT,
        start_new_session=True,
    )
    socket = root / "run" / "whatevr" / "whatevrd.sock"

    def daemon_ready() -> bool:
        if proc.poll() is not None:
            raise Failure(f"whatevrd exited with {proc.returncode}; see {log_path}")
        return socket.exists()

    wait_for("the whatevrd socket", daemon_ready)
    return proc, socket, log_path


def stop_process(proc: subprocess.Popen[Any]) -> None:
    if proc.poll() is None:
        os.killpg(proc.pid, signal.SIGTERM)
        try:
            proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            os.killpg(proc.pid, signal.SIGKILL)
            proc.wait(timeout=5)


def self_check() -> dict[str, Any]:
    required_tools()
    name = validate_account()
    if not KITTY_CONFIG.is_file():
        raise Failure(f"missing {KITTY_CONFIG}")
    return {
        "account": name,
        "account_chat": ACCOUNTS[name][0],
        "kitty_config": str(KITTY_CONFIG.relative_to(ROOT)),
        "tools": tools_metadata(),
    }


def install_signal_handlers() -> None:
    def interrupted(signum: int, _frame: Any) -> None:
        raise SignalExit(signum)

    signal.signal(signal.SIGINT, interrupted)
    signal.signal(signal.SIGTERM, interrupted)


def parse_size(text: str) -> tuple[int, int]:
    try:
        cols, rows = (int(part) for part in text.lower().split("x", 1))
    except ValueError:
        raise Failure(f"bad size {text!r}, want COLSxROWS such as 120x40") from None
    if cols < 20 or rows < 6:
        raise Failure(f"{text} is smaller than whattui can draw")
    return cols, rows


def shots_from(args: argparse.Namespace) -> list[dict[str, Any]]:
    """What to photograph: a scenario, an ad hoc key sequence, or the default."""
    sizes = [parse_size(text) for text in args.size]
    keys = [key for group in args.keys for key in group.split(",") if key]
    names = args.scenario or ([] if (keys or sizes) else ["chat"])

    shots: list[dict[str, Any]] = []
    for name in names:
        cols, rows, scenario_keys, marker = SCENARIOS[name]
        for size in sizes or [(cols, rows)]:
            shots.append(
                {
                    "name": f"{name}-{size[0]}x{size[1]}",
                    "size": size,
                    "keys": scenario_keys,
                    "marker": marker,
                }
            )
    if keys:
        for size in sizes or [DEFAULT_SIZE]:
            shots.append(
                {
                    "name": args.name or f"keys-{size[0]}x{size[1]}",
                    "size": size,
                    "keys": keys,
                    "marker": args.wait or "",
                }
            )
    elif not names:
        for size in sizes:
            shots.append(
                {
                    "name": args.name or f"chat-{size[0]}x{size[1]}",
                    "size": size,
                    "keys": [],
                    "marker": "",
                }
            )
    return shots


def main() -> int:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument(
        "--size",
        action="append",
        default=[],
        metavar="COLSxROWS",
        help="terminal size to shoot at (repeatable; default 120x40)",
    )
    parser.add_argument(
        "--scenario",
        action="append",
        choices=sorted(SCENARIOS),
        help="a state worth a picture (repeatable; see --list)",
    )
    parser.add_argument(
        "--keys",
        action="append",
        default=[],
        metavar="K1,K2",
        help="kitty key names to send before the shot, such as ctrl+p or /,a,n",
    )
    parser.add_argument(
        "--wait",
        metavar="TEXT",
        help="with --keys, text that must be on screen before the shot",
    )
    parser.add_argument("--name", help="basename for an ad hoc shot")
    parser.add_argument(
        "--font-size",
        metavar="PT[,PT...]",
        help="change the font size once whattui is up, which resizes the grid "
        "under it without touching the window; several are applied in turn, "
        "which is what a person leaning on the key does",
    )
    parser.add_argument(
        "--env",
        action="append",
        default=[],
        metavar="KEY=VALUE",
        help="environment for whattui, such as WHATTUI_TIER=graphics or "
        "WHATTUI_NO_TEXT_SCALE=1 (repeatable)",
    )
    parser.add_argument(
        "--account",
        choices=sorted(ACCOUNTS),
        help=f"mock scenario to photograph (default {DEFAULT_ACCOUNT})",
    )
    parser.add_argument(
        "--out",
        type=Path,
        default=OUTPUT,
        help=f"where the pngs go (default {OUTPUT.relative_to(ROOT)})",
    )
    parser.add_argument(
        "--plain",
        action="store_true",
        help="force the plain tier, which is what a terminal without graphics shows",
    )
    parser.add_argument(
        "--hidden-resize",
        action="store_true",
        help="resize behind a covering tab before the shot, which is the reflow no one watches",
    )
    parser.add_argument("--list", action="store_true", help="list the scenarios")
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="validate inputs and tools without building or opening windows",
    )
    parser.add_argument(
        "--probe",
        action="store_true",
        help="create, configure, verify, and remove a Hyprland headless output",
    )
    parser.add_argument(
        "--keep-run-dir",
        action="store_true",
        help="keep intermediate ready files and sockets after failure",
    )
    parser.add_argument("--_child", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--child-ready", help=argparse.SUPPRESS)
    parser.add_argument("--child-log", help=argparse.SUPPRESS)
    parser.add_argument(
        "child_command", nargs=argparse.REMAINDER, help=argparse.SUPPRESS
    )
    args = parser.parse_args()
    if args._child:
        if args.child_command and args.child_command[0] == "--":
            args.child_command = args.child_command[1:]
        return child_mode(args)

    for pair in args.env:
        key, sep, value = pair.partition("=")
        if not sep or not key:
            raise Failure(f"bad --env {pair!r}, want KEY=VALUE")
        EXTRA_ENV[key] = value

    if args.account:
        global account
        account = args.account

    if args.list:
        print("states:")
        for name, (cols, rows, keys, _) in sorted(SCENARIOS.items()):
            print(f"  {name:14} {cols}x{rows:<4} {' '.join(keys) or '(nothing typed)'}")
        print("accounts (--account):")
        for name, (chat, _) in sorted(ACCOUNTS.items()):
            print(f"  {name:14} {chat or '(nothing in it)'}")
        return 0

    checked = self_check()
    if args.dry_run:
        print(json.dumps({**checked, "shots": shots_from(args)}, indent=2, default=str))
        return 0
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        raise Failure("a live Hyprland session is required for pixel capture")

    shots = shots_from(args)
    install_signal_handlers()
    headless = HeadlessOutput()
    if args.probe:
        try:
            headless.create()
            print(json.dumps(headless.metadata(), indent=2))
            return 0
        finally:
            headless.remove()

    out = args.out
    run_dir = out / "run"
    run_dir.mkdir(parents=True, exist_ok=True)
    binaries = build_binaries(run_dir)
    daemon_proc: subprocess.Popen[Any] | None = None
    harness: Harness | None = None
    taken: list[Path] = []
    try:
        headless.create()
        daemon_proc, daemon_socket, _ = start_daemon(run_dir, binaries["whatevrd"])
        harness = Harness(out, binaries, daemon_socket, headless)
        for shot in shots:
            cols, rows = shot["size"]
            name = shot["name"]
            if args.hidden_resize:
                # The window is opened larger and shrunk while a tab covers
                # it, so what is photographed is a reflow nobody watched
                # happen. Visibility reports stay on for exactly this.
                state = harness.launch(120, 40, name, plain=args.plain, visibility=True)
                harness.hidden_tab_resize(state, cols, rows)
            else:
                state = harness.launch(cols, rows, name, plain=args.plain)
            for step in (args.font_size or "").split(","):
                if not step.strip():
                    continue
                # The window stands still, so the grid under whattui changes
                # size: what gets photographed is whatever it is afterwards.
                harness.set_font_size(state, float(step))
                cols, rows = harness.pty_size(state)
            if shot["keys"]:
                harness.open_surface(state, shot["keys"], shot["marker"])
            harness.capture(state, name, (cols, rows))
            harness.close(state)
            taken.append(out / f"{name}.png")
    except SignalExit as exc:
        print(f"whattui-screenshot: {exc}", file=sys.stderr)
        return 130
    finally:
        if harness is not None:
            harness.cleanup()
        if daemon_proc is not None:
            stop_process(daemon_proc)
        headless.remove()
        if not args.keep_run_dir:
            shutil.rmtree(run_dir, ignore_errors=True)

    for path in taken:
        print(path)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (Failure, OSError, json.JSONDecodeError, SignalExit) as exc:
        print(f"whattui-screenshot: {exc}", file=sys.stderr)
        raise SystemExit(1)
