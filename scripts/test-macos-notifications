#!/usr/bin/env python3
"""Interactive-session IPC smoke test; never requests notification permission."""
import json
import socket
import subprocess
import sys
from pathlib import Path

binary = Path(sys.argv[1] if len(sys.argv) > 1 else "build/release/whatevrd").resolve()
subprocess.run([str(binary), "notifications", "status"], check=True)
runtime = subprocess.check_output(["/usr/bin/getconf", "DARWIN_USER_TEMP_DIR"], text=True).strip()
path = str(Path(runtime) / "whatevr/notifications.sock")
requests = [({"version": 1, "type": "status"}, "status"),
            ({"version": 1, "type": "hello", "namespace": "1" * 32}, "status"),
            ({"version": 2, "type": "status"}, None),
            ({"version": 1, "type": "hello", "namespace": "bad"}, None)]
if "--stop-if-idle" in sys.argv:
    requests.append(({"version": 1, "type": "quit-if-idle"}, "status"))
for request, expected in requests:
    with socket.socket(socket.AF_UNIX) as peer:
        peer.settimeout(5)
        peer.connect(path)
        peer.sendall(json.dumps(request).encode() + b"\n")
        response = peer.makefile("rb").readline(1 << 20)
        if expected:
            message = json.loads(response)
            assert message["version"] == 1 and message["type"] == expected, message
        else:
            assert not response, response
print("Native helper IPC: status, version and namespace validation passed")
