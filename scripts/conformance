#!/usr/bin/env python3
"""Conformance checks for the whatevr protocol grammar.

Three modes. With no arguments it checks the handshake and the view grammar
against a synthetic fixture. `--replay FILE` runs the same client against a
stream recorded from a real daemon by scripts/record-stream, asserting the
window invariants after every frame. `--soak SECONDS` keeps doing that with
faults armed, which is how a rare path gets hit often enough to matter.
"""

from __future__ import annotations

import argparse
import json
import os
import random
import socket
import subprocess
import sys
import tempfile
import time
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
FIXTURE_SOCKET_ENV = "WHATEVR_CONFORMANCE_SOCKET"


class Failure(Exception):
    pass


def require(condition: bool, message: str) -> None:
    if not condition:
        raise Failure(message)


class Client:
    def __init__(self, socket_path: Path) -> None:
        self.socket_path = socket_path
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(5)
        self.sock.connect(str(socket_path))
        self.buf = b""
        self.seen_response_ids: set[object] = set()

    def close(self) -> None:
        self.sock.close()

    def __enter__(self) -> "Client":
        return self

    def __exit__(self, *_exc: object) -> None:
        self.close()

    def send(self, obj: dict[str, object]) -> None:
        line = json.dumps(obj, separators=(",", ":")).encode("utf-8")
        self.sock.sendall(line + b"\n")

    def recv(self, timeout: float = 5) -> dict[str, object]:
        self.sock.settimeout(timeout)
        while b"\n" not in self.buf:
            try:
                chunk = self.sock.recv(4096)
            except TimeoutError as exc:
                raise Failure(f"timed out reading from {self.socket_path}") from exc
            if not chunk:
                raise Failure(f"connection closed by {self.socket_path}")
            self.buf += chunk

        line, self.buf = self.buf.split(b"\n", 1)
        try:
            msg = json.loads(line)
        except json.JSONDecodeError as exc:
            raise Failure(f"wire line is not JSON: {line!r}") from exc
        require(isinstance(msg, dict), f"wire line is not a JSON object: {msg!r}")
        return msg

    def expect_response(self, req_id: object, error_code: str | None = None) -> dict[str, object]:
        msg = self.recv()
        require("id" in msg, f"expected response for {req_id!r}, got event {msg!r}")
        require(msg["id"] == req_id, f"response id = {msg['id']!r}, want {req_id!r}: {msg!r}")
        require(req_id not in self.seen_response_ids, f"duplicate response for id {req_id!r}")
        self.seen_response_ids.add(req_id)

        has_result = "result" in msg
        has_error = "error" in msg
        require(has_result != has_error, f"response must carry exactly one of result/error: {msg!r}")
        if error_code is None:
            require(has_result, f"expected success response, got {msg!r}")
        else:
            require(has_error, f"expected error response, got {msg!r}")
            err = msg["error"]
            require(isinstance(err, dict), f"error is not an object: {msg!r}")
            require(err.get("code") == error_code, f"error code = {err.get('code')!r}, want {error_code!r}")
            require(isinstance(err.get("message"), str) and err["message"], f"error has no message: {msg!r}")
        return msg

    def expect_event(self, event: str, sub: int) -> dict[str, object]:
        msg = self.recv()
        require("id" not in msg, f"expected {event} event, got response {msg!r}")
        require(msg.get("event") == event, f"event = {msg.get('event')!r}, want {event!r}: {msg!r}")
        require(msg.get("sub") == sub, f"event sub = {msg.get('sub')!r}, want {sub!r}: {msg!r}")
        return msg

    def expect_idle(self, timeout: float = 0.2) -> None:
        require(not self.buf.strip(), f"unexpected buffered traffic: {self.buf!r}")
        self.sock.settimeout(timeout)
        try:
            chunk = self.sock.recv(4096)
        except TimeoutError:
            return
        require(not chunk, f"unexpected extra traffic: {chunk!r}")

    def expect_closed(self) -> None:
        require(not self.buf.strip(), f"unexpected buffered traffic before close: {self.buf!r}")
        self.sock.settimeout(5)
        try:
            chunk = self.sock.recv(4096)
        except TimeoutError as exc:
            raise Failure("connection did not close after rejected hello") from exc
        require(not chunk, f"expected connection close, got {chunk!r}")


def start_fixture(script: Path | None = None,
                  faults: str = "") -> tuple[tempfile.TemporaryDirectory[str] | None, subprocess.Popen[str] | None, Path]:
    external = os.environ.get(FIXTURE_SOCKET_ENV)
    if external:
        return None, None, Path(external)

    tmp = tempfile.TemporaryDirectory(prefix="whatevr-conformance-")
    socket_dir = Path(tmp.name) / "whatevr"
    socket_dir.mkdir(mode=0o700)
    socket_path = socket_dir / "whatevrd.sock"
    ready_file = Path(tmp.name) / "ready"
    fixture_bin = Path(tmp.name) / "protocol-fixture"
    build = subprocess.run(
        ["go", "build", "-buildvcs=false", "-o", str(fixture_bin), "./cmd/protocol-fixture"],
        cwd=ROOT / "whatevrd",
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    if build.returncode != 0:
        raise Failure(f"fixture build failed\nstdout:\n{build.stdout}\nstderr:\n{build.stderr}")

    cmd = [
        str(fixture_bin),
        "--socket",
        str(socket_path),
        "--ready-file",
        str(ready_file),
    ]
    if script is not None:
        cmd += ["--script", str(script)]
    if faults:
        cmd += ["--fault", faults]
    proc = subprocess.Popen(
        cmd,
        cwd=ROOT / "whatevrd",
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )

    deadline = time.time() + 30
    while time.time() < deadline:
        if ready_file.exists() and socket_path.exists():
            return tmp, proc, socket_path
        if proc.poll() is not None:
            stdout, stderr = proc.communicate(timeout=1)
            raise Failure(f"fixture exited early\nstdout:\n{stdout}\nstderr:\n{stderr}")
        time.sleep(0.025)
    stop_fixture(tmp, proc)
    raise Failure("timed out waiting for protocol fixture")


def stop_fixture(tmp: tempfile.TemporaryDirectory[str] | None, proc: subprocess.Popen[str] | None) -> None:
    if proc is not None and proc.poll() is None:
        proc.terminate()
        try:
            proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait(timeout=5)
    if tmp is not None:
        tmp.cleanup()


def say(message: str) -> None:
    print(f"ok - {message}")


def hello(c: Client, req_id: object = "hello") -> dict[str, object]:
    c.send({"id": req_id, "method": "hello", "params": {"client": "conformance", "protocol": 1}})
    return c.expect_response(req_id)


def check_hello(socket_path: Path) -> None:
    with Client(socket_path) as c:
        resp = hello(c)
        result = resp["result"]
        require(isinstance(result, dict), f"hello result is not an object: {resp!r}")
        require(result.get("daemon") == "whatevrd", f"hello daemon mismatch: {resp!r}")
        require(result.get("protocol") == 1, f"hello protocol mismatch: {resp!r}")
        require(result.get("state") == "online", f"hello state mismatch: {resp!r}")
        require(isinstance(result.get("data_dir"), str), f"hello missing data_dir: {resp!r}")
        require(isinstance(result.get("cache_dir"), str), f"hello missing cache_dir: {resp!r}")
    say("hello negotiation")


def check_hello_rejects_unsupported_protocol(socket_path: Path) -> None:
    with Client(socket_path) as c:
        c.send({"id": "bad-protocol", "method": "hello", "params": {"client": "conformance", "protocol": 2}})
        c.expect_response("bad-protocol", error_code="invalid_params")
        c.expect_closed()
    say("unsupported protocol rejects connection")


def check_unknown_method(socket_path: Path) -> None:
    with Client(socket_path) as c:
        hello(c)
        c.send({"id": "unknown", "method": "no.such.method"})
        c.expect_response("unknown", error_code="unknown_method")
        c.expect_idle()
    say("unknown-method error and single response")


def check_subscribe_ordering(socket_path: Path) -> None:
    with Client(socket_path) as c:
        hello(c)
        c.send({"id": "sub", "method": "subscribe", "params": {"view": "conformance", "limit": 2}})
        resp = c.expect_response("sub")
        result = resp["result"]
        require(isinstance(result, dict), f"subscribe result is not an object: {resp!r}")
        sub = result.get("sub")
        require(isinstance(sub, int), f"subscribe result has no integer sub: {resp!r}")

        previous_sort = ""
        for item_id in ("alpha", "bravo"):
            msg = c.expect_event("upsert", sub)
            sort_key = msg.get("sort")
            require(isinstance(sort_key, str) and sort_key, f"upsert has no sort: {msg!r}")
            require(sort_key > previous_sort, f"upserts not in ascending sort order: {msg!r}")
            previous_sort = sort_key
            item = msg.get("item")
            require(isinstance(item, dict), f"upsert item is not an object: {msg!r}")
            require(item.get("id") == item_id, f"upsert item id = {item.get('id')!r}, want {item_id!r}")
        ready = c.expect_event("ready", sub)
        require(ready.get("exhausted", False) is False, f"initial window should not be exhausted: {ready!r}")

        # extend requires a direction; omitting it is invalid_params.
        c.send({"id": "extend-nodir", "method": "extend", "params": {"sub": sub, "count": 2}})
        c.expect_response("extend-nodir", "invalid_params")

        c.send({"id": "extend", "method": "extend", "params": {"sub": sub, "count": 2, "direction": "older"}})
        c.expect_response("extend")
        msg = c.expect_event("upsert", sub)
        item = msg.get("item")
        require(isinstance(msg.get("sort"), str) and msg["sort"], f"extended upsert has no sort: {msg!r}")
        require(isinstance(item, dict) and item.get("id") == "charlie", f"extended item mismatch: {msg!r}")
        ready = c.expect_event("ready", sub)
        require(ready.get("exhausted") is True, f"extended window should be exhausted: {ready!r}")
        c.expect_idle()
    say("subscribe/extend response, upsert, ready ordering")



# ---------------------------------------------------------------- replay

class Window:
    """One subscription's local copy, applied by PROTOCOL.md's universal
    algorithm: keyed upserts ordered by the opaque sort key."""

    def __init__(self, view: str, sub: int) -> None:
        self.view = view
        self.sub = sub
        self.rows: dict[str, str] = {}   # id -> sort
        self.ready_seen = False
        self.exhausted = False
        self.closed = False
        # The sort key each id was first delivered with, kept for the whole
        # connection so a re-ingest that moves one is caught even after a reset.
        self.first_sort: dict[str, str] = {}
        # Delivery order within the current fill, cleared by ready and reset.
        self.fill_sorts: list[str] = []
        self.upserts_since_ready = 0


def apply_frame(window: Window, msg: dict[str, object]) -> None:
    """Apply one frame and assert what has to hold afterwards.

    Each of these is a bug that shipped. A fill delivered out of sort order made
    a transcript assemble backwards before its first ready. A re-ingest that
    moved an id's sort key reordered the rows under the reader. `exhausted` on a
    window that just grew is the phone-history strip claiming there is nothing
    older when the next extend returns more.
    """
    event = msg.get("event")
    require(not window.closed,
            f"{window.view}: a frame arrived for a subscription already closed: {msg!r}")

    if event == "upsert":
        item = msg.get("item")
        require(isinstance(item, dict) and isinstance(item.get("id"), str) and item["id"],
                f"{window.view}: upsert item has no id: {msg!r}")
        sort_key = msg.get("sort")
        require(isinstance(sort_key, str) and sort_key,
                f"{window.view}: upsert has no sort: {msg!r}")
        item_id = item["id"]

        known = window.first_sort.get(item_id)
        require(known is None or known == sort_key,
                f"{window.view}: id {item_id!r} changed sort key {known!r} -> {sort_key!r}, "
                f"which reorders the window under the reader: {msg!r}")
        window.first_sort[item_id] = sort_key

        # Within one fill the daemon delivers in ascending sort order, so a
        # client that appends is already correct before it sorts anything.
        if window.fill_sorts:
            require(sort_key >= window.fill_sorts[-1],
                    f"{window.view}: fill delivered {sort_key!r} after {window.fill_sorts[-1]!r}, "
                    f"which is out of order: {msg!r}")
        window.fill_sorts.append(sort_key)
        window.rows[item_id] = sort_key
        window.upserts_since_ready += 1

    elif event == "remove":
        require(isinstance(msg.get("id"), str) and msg["id"],
                f"{window.view}: remove has no id: {msg!r}")
        window.rows.pop(msg["id"], None)

    elif event == "reset":
        window.rows.clear()
        window.fill_sorts.clear()
        window.upserts_since_ready = 0
        window.ready_seen = False

    elif event == "ready":
        exhausted = msg.get("exhausted", False)
        require(isinstance(exhausted, bool),
                f"{window.view}: ready carries a non-boolean exhausted: {msg!r}")
        # A window that just grew cannot also be at the end of history. The one
        # exception is a window that was already exhausted and grew by nothing.
        if window.ready_seen and exhausted and window.upserts_since_ready > 0:
            require(window.exhausted is False or window.upserts_since_ready == 0,
                    f"{window.view}: ready says exhausted after delivering "
                    f"{window.upserts_since_ready} more row(s): {msg!r}")
        window.ready_seen = True
        window.exhausted = bool(exhausted)
        window.fill_sorts.clear()
        window.upserts_since_ready = 0

    else:
        raise Failure(f"{window.view}: unknown view event {event!r}: {msg!r}")

    # No duplicate rows, ever: two rows for one message is what the keyed
    # upsert exists to prevent.
    require(len(window.rows) == len(set(window.rows)),
            f"{window.view}: the window holds a duplicate id: {msg!r}")


def replay_stream(socket_path: Path, label: str) -> int:
    """Open every view the recording covers and walk each window to its end.

    Returns the number of frames the daemon sent back, which is what a soak
    reports so a run that quietly stopped doing anything is visible.
    """
    frames = 0
    with Client(socket_path) as c:
        hello(c)
        windows: dict[int, Window] = {}
        pending: dict[object, str] = {}
        opened = 0
        closed = 0

        for view in REPLAY_VIEWS:
            req = f"sub-{view}"
            c.send({"id": req, "method": "subscribe",
                    "params": {"view": view, "limit": 20}})
            pending[req] = view

        # One pass: subscribe answers register windows, view events apply.
        deadline = time.time() + 20
        while pending and time.time() < deadline:
            msg = c.recv(timeout=5)
            frames += 1
            if "id" in msg:
                view = pending.pop(msg["id"], None)
                if view is None:
                    continue
                if "error" in msg:
                    # A recording that did not cover this view is not a
                    # failure; a malformed error is.
                    err = msg["error"]
                    require(isinstance(err, dict) and err.get("code"),
                            f"subscribe error has no code: {msg!r}")
                    continue
                result = msg["result"]
                require(isinstance(result, dict) and isinstance(result.get("sub"), int),
                        f"subscribe result has no sub: {msg!r}")
                windows[result["sub"]] = Window(view, result["sub"])
                opened += 1
                continue

            sub = msg.get("sub")
            require(isinstance(sub, int) and sub in windows,
                    f"event names a subscription that was never opened: {msg!r}")
            apply_frame(windows[sub], msg)

        require(windows, f"{label}: the recording opened no windows at all")

        # Walk each window to its end the way a reader scrolling does, and hold
        # the invariants across every extend.
        for window in list(windows.values()):
            for step in range(8):
                if window.exhausted:
                    break
                req = f"extend-{window.sub}-{step}"
                c.send({"id": req, "method": "extend",
                        "params": {"sub": window.sub, "count": 20, "direction": "older"}})
                answered = False
                while not answered and time.time() < deadline:
                    msg = c.recv(timeout=5)
                    frames += 1
                    if msg.get("id") == req:
                        answered = True
                        if "error" in msg:
                            # A view with no window to grow rejects the extend,
                            # which is the documented answer, not a failure.
                            window.exhausted = True
                        continue
                    sub = msg.get("sub")
                    if not isinstance(sub, int) or sub not in windows:
                        continue
                    apply_frame(windows[sub], msg)

        # Every window opened is a window closed. A subscription left behind is
        # a view session the daemon keeps feeding for a frontend that is gone.
        for window in windows.values():
            c.send({"id": f"unsub-{window.sub}", "method": "unsubscribe",
                    "params": {"sub": window.sub}})
            window.closed = True
            closed += 1
        deadline = time.time() + 10
        answered = 0
        while answered < closed and time.time() < deadline:
            msg = c.recv(timeout=5)
            frames += 1
            if "id" in msg:
                answered += 1
        require(answered == closed,
                f"{label}: opened {opened} subscriptions and closed {answered} of {closed}")
    return frames


# The views a recording is asked to replay. Transcript-shaped ones first: they
# are where a gap or a reordering actually hurts.
REPLAY_VIEWS = ["messages", "chats", "chat", "pinned", "chat_media", "live_locations",
                "stickers", "sticker_packs", "transfers"]


def check_replay(script: Path) -> int:
    tmp, proc, socket_path = start_fixture(script=script)
    try:
        frames = replay_stream(socket_path, "replay")
        say(f"replayed {script.name}: {frames} frames, windows consistent throughout")
        return 0
    finally:
        stop_fixture(tmp, proc)


def check_soak(script: Path, seconds: float, faults: str) -> int:
    deadline = time.time() + seconds
    rounds = 0
    total = 0
    while time.time() < deadline:
        rounds += 1
        tmp, proc, socket_path = start_fixture(script=script, faults=faults)
        try:
            total += replay_stream(socket_path, f"soak round {rounds}")
        finally:
            stop_fixture(tmp, proc)
    require(rounds > 0, "the soak ran no rounds; give it more seconds")
    say(f"soak: {rounds} round(s), {total} frames, faults {faults!r}, windows consistent throughout")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="whatevr protocol conformance")
    parser.add_argument("--replay", metavar="FILE",
                        help="replay a stream recorded by scripts/record-stream")
    parser.add_argument("--soak", metavar="SECONDS", type=float,
                        help="replay repeatedly with faults armed, for this long")
    parser.add_argument("--fault", default="all:7",
                        help="faults to arm during a soak (default: all:7)")
    parser.add_argument("--seed", type=int, help="seed for anything that varies")
    args = parser.parse_args()

    if args.seed is not None:
        random.seed(args.seed)

    tmp = None
    proc = None
    try:
        if args.soak is not None:
            require(args.replay is not None, "--soak needs a --replay stream to soak")
            return check_soak(Path(args.replay), args.soak, args.fault)
        if args.replay is not None:
            return check_replay(Path(args.replay))

        tmp, proc, socket_path = start_fixture()
        print(f"conformance socket: {socket_path}")
        check_hello(socket_path)
        check_hello_rejects_unsupported_protocol(socket_path)
        check_unknown_method(socket_path)
        check_subscribe_ordering(socket_path)
        print("conformance: pass")
        return 0
    except Failure as exc:
        print(f"conformance: FAIL: {exc}", file=sys.stderr)
        return 1
    finally:
        stop_fixture(tmp, proc)


if __name__ == "__main__":
    raise SystemExit(main())
