#!/usr/bin/env bash
# The mock WhatsApp server mutates process-global TLS trust and overwrites
# whatsmeow's pinned certificate key. None of that may exist in a shipped
# binary, so it lives behind -tags whatevr_mock.
#
# A build tag is only a gate if something checks it. This asserts three things:
# the release dependency graph does not contain the package, a release binary
# refuses --mock, and the mock build does contain it (otherwise a typo in the
# pattern would make this pass while checking nothing).
set -euo pipefail

cd "$(dirname "$0")/.."

pkg="whatevrd/internal/wamock"
release_tags="sqlite_fts5"
mock_tags="sqlite_fts5 whatevr_mock"
status=0

fail() {
    printf 'FAIL: %s\n' "$1" >&2
    status=1
}

# 1. The release graph must not reach the package.
if go -C whatevrd list -tags "$release_tags" -deps ./cmd/whatevrd | grep -qx "$pkg"; then
    fail "$pkg is in the release dependency graph of cmd/whatevrd"
else
    printf 'ok: release build does not link %s\n' "$pkg"
fi

# 2. The mock graph must reach it, or check 1 proves nothing.
if go -C whatevrd list -tags "$mock_tags" -deps ./cmd/whatevrd | grep -qx "$pkg"; then
    printf 'ok: mock build links %s\n' "$pkg"
else
    fail "$pkg is missing from the mock build; this check would pass vacuously"
fi

# 3. A release binary must reject the flag rather than ignore it.
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
CGO_ENABLED=1 go -C whatevrd build -tags "$release_tags" -o "$tmp/whatevrd" ./cmd/whatevrd

if out="$("$tmp/whatevrd" --mock empty 2>&1)"; then
    fail "release binary accepted --mock"
elif printf '%s' "$out" | grep -q "without mock support"; then
    printf 'ok: release binary refuses --mock\n'
else
    fail "release binary failed on --mock for the wrong reason: $out"
fi

exit "$status"
