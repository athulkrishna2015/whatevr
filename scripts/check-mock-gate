#!/usr/bin/env bash
# The mock WhatsApp server mutates process-global TLS trust and overwrites
# whatsmeow's pinned certificate key. None of that may exist in a shipped
# binary, so it lives behind -tags whatevr_mock.
#
# A build tag is only a gate if something checks it. This asserts three things:
# the release dependency graph does not contain the package, a release binary
# refuses --mock, and the mock build does contain it (otherwise a typo in the
# pattern would make this pass while checking nothing).
#
# Captures hold every message in plaintext, so internal/capture sits behind
# -tags whatevr_capture and gets the same three checks. A release binary also
# has to refuse a flag it does not know: one that ignored it would start on the
# real account. Every release binary run here gets a scratch HOME and XDG tree,
# so a regression fails the check instead of reaching that account.
set -euo pipefail

cd "$(dirname "$0")/.."

pkg="whatevrd/internal/wamock"
capture_pkg="whatevrd/internal/capture"
release_tags="sqlite_fts5"
mock_tags="sqlite_fts5 whatevr_mock"
capture_tags="sqlite_fts5 whatevr_capture"
status=0

fail() {
    printf 'FAIL: %s\n' "$1" >&2
    status=1
}

# 1. The release graph must not reach the package.
if go -C whatevrd list -tags "$release_tags" -deps ./cmd/whatevrd | grep -qx "$pkg"; then
    fail "$pkg is in the release dependency graph of cmd/whatevrd"
else
    printf 'ok: release build does not link %s\n' "$pkg"
fi

# 2. The mock graph must reach it, or check 1 proves nothing.
if go -C whatevrd list -tags "$mock_tags" -deps ./cmd/whatevrd | grep -qx "$pkg"; then
    printf 'ok: mock build links %s\n' "$pkg"
else
    fail "$pkg is missing from the mock build; this check would pass vacuously"
fi

if go -C whatevrd list -tags "$release_tags" -deps ./cmd/whatevrd | grep -qx "$capture_pkg"; then
    fail "$capture_pkg is in the release dependency graph of cmd/whatevrd"
else
    printf 'ok: release build does not link %s\n' "$capture_pkg"
fi
if go -C whatevrd list -tags "$capture_tags" -deps ./cmd/whatevrd | grep -qx "$capture_pkg"; then
    printf 'ok: capture build links %s\n' "$capture_pkg"
else
    fail "$capture_pkg is missing from the capture build; this check would pass vacuously"
fi

# the new core runs beside the old one only in debug builds until it
# replaces it, so its adapter stays out of release the same way
core_pkg="whatevrd/internal/v1"
core_tags="sqlite_fts5 whatevr_core"
if go -C whatevrd list -tags "$release_tags" -deps ./cmd/whatevrd | grep -qx "$core_pkg"; then
    fail "$core_pkg is in the release dependency graph of cmd/whatevrd"
else
    printf 'ok: release build does not link %s\n' "$core_pkg"
fi
if go -C whatevrd list -tags "$core_tags" -deps ./cmd/whatevrd | grep -qx "$core_pkg"; then
    printf 'ok: core build links %s\n' "$core_pkg"
else
    fail "$core_pkg is missing from the core build; this check would pass vacuously"
fi

# 3. A release binary must reject the flags rather than ignore them.
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
CGO_ENABLED=1 go -C whatevrd build -tags "$release_tags" -o "$tmp/whatevrd" ./cmd/whatevrd
mkdir -p "$tmp/home" "$tmp/run"

release() {
    env HOME="$tmp/home" XDG_RUNTIME_DIR="$tmp/run" XDG_DATA_HOME="$tmp/home/data" \
        XDG_CACHE_HOME="$tmp/home/cache" XDG_STATE_HOME="$tmp/home/state" XDG_CONFIG_HOME="$tmp/home/config" \
        timeout 10 "$tmp/whatevrd" "$@" 2>&1
}

refuses() {
    local want="$1"
    shift
    if out="$(release "$@")"; then
        fail "release binary accepted $*"
    elif printf '%s' "$out" | grep -q "$want"; then
        printf 'ok: release binary refuses %s\n' "$*"
    else
        fail "release binary failed on $* for the wrong reason: $out"
    fi
}

refuses "without mock support" --mock empty
refuses "without capture support" --capture probe
refuses "without capture support" --send-guard
refuses "without capture support" capture list
refuses "without the new core" --core new
refuses "flag provided but not defined" --no-such-flag

exit "$status"
